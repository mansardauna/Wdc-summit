# PostgreSQL / Supabase Connection
# Provide your Supabase or PostgreSQL URI below to store all CMS content, leads, applications, payments, and contacts in Postgres.
# When omitted, the app automatically persists everything to local storage in data/cms-store.json so it works out-of-the-box!
DATABASE_URL=""

# Paystack API Keys (Can also be configured directly inside the /admin CMS Settings panel)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# Flutterwave API Keys (Can also be configured directly inside the /admin CMS Settings panel)
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# Base URL for payment callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin CMS Password (default: admin2027)
CMS_ADMIN_PASSWORD="admin2027"
